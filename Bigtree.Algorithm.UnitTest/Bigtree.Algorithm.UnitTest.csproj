<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.8.3" />
    <!-- Build-time only: weaves the tests' [NDScoped] methods, so each test's NDArrays return to NumSharp's pool. -->
    <PackageReference Include="NumSharp.Build" Version="0.80.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bigtree.Algorithm\Bigtree.Algorithm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The seeds dataset lives at the repository root (the examples read it too); the tests read it as data/. -->
    <None Include="..\data\seeds_dataset.csv" Link="data\seeds_dataset.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
